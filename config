ngx_addon_name=ngx_stream_limit_req_module

# The module lives in the stream subsystem, so a build without --with-stream
# has nothing to put it in.  Saying so here is friendlier than a link error
# about ngx_stream_core_module half an hour later.
if [ "$STREAM" != YES ]; then
    echo
    echo "$0: error: ngx_stream_limit_req_module requires --with-stream"
    echo
    exit 1
fi

if test -n "$ngx_module_link"; then
    ngx_module_type=STREAM
    ngx_module_name=$ngx_addon_name
    ngx_module_srcs="$ngx_addon_dir/src/ngx_stream_limit_req_module.c"

    . auto/module
else
    STREAM_MODULES="$STREAM_MODULES ngx_stream_limit_req_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS \
        $ngx_addon_dir/src/ngx_stream_limit_req_module.c"
fi
